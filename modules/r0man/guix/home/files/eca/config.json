{
  "providers": {
    "anthropic": {
      "api": "anthropic",
      "url": "https://api.anthropic.com",
      "key": "${netrc:apikey@api.anthropic.com}",
      "fetchModels": false,
      "models": {
        "sonnet-4.6": {"modelName": "claude-sonnet-4-6"},
        "opus-4.8": {"modelName": "claude-opus-4-8"},
        "fable-5": {"modelName": "claude-fable-5"}
      }
    }
  },
  "defaultModel": "anthropic/fable-5",
  "toolCall": {
    "approval": {
      "byDefault": "allow"
    }
  }
}
