{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "0.25"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(guix:*)"
    ],
    "deny": [
      "Read(~/.authinfo)",
      "Read(~/.authinfo.gpg)",
      "Read(~/.aws/**)",
      "Read(~/.password-store/**)",
      "Read(~/Mail/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "beads@beads-marketplace": false,
    "skill-creator@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "beads-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/gastownhall/beads.git"
      }
    }
  },
  "tui": "default",
  "voice": {
    "enabled": false
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
